theory TwistedPearLinkHandshake
begin

builtins: diffie-hellman, signing, hashing
functions: kdf/2

rule RegisterIdentity:
  [ Fr(~ltk) ]
  --> [ !Identity($A, ~ltk), Out(pk(~ltk)) ]

rule InitiatorBegin:
  [ !Identity($I, ltkI), !Identity($R, ltkR), Fr(~x), Fr(~link) ]
  --[ InitiatorBegin($I, $R, ~link, 'g'^~x) ]->
  [ InitiatorPending($I, $R, ~link, ~x),
    Out(<$I, $R, ~link, 'g'^~x, sign(<$I, $R, ~link, 'g'^~x>, ltkI)>) ]

rule ResponderAccept:
  [ !Identity(I, ltkI), !Identity($R, ltkR),
    In(<I, $R, link, X, sign(<I, $R, link, X>, ltkI)>), Fr(~y) ]
  --[ ResponderBegin(I, $R, link, X), ResponderEstablished(I, $R, link, kdf(X^~y, link)), Secret(kdf(X^~y, link)) ]->
  [ Out(<$R, I, link, 'g'^~y, sign(<$R, I, link, 'g'^~y>, ltkR)>) ]

rule InitiatorAccept:
  [ !Identity(I, ltkI), !Identity(R, ltkR), InitiatorPending(I, R, link, x),
    In(<R, I, link, Y, sign(<R, I, link, Y>, ltkR)>) ]
  --[ InitiatorEstablished(I, R, link, kdf(Y^x, link)), Secret(kdf(Y^x, link)) ]->
  [ ]

lemma executable_trace_exists:
  exists-trace
  "Ex I R link key #i #r. InitiatorEstablished(I,R,link,key)@i & ResponderEstablished(I,R,link,key)@r"

lemma session_key_secrecy:
  "All key #i. Secret(key)@i ==> not (Ex #j. K(key)@j)"

lemma initiator_authenticates_responder:
  "All I R link key #i. InitiatorEstablished(I,R,link,key)@i
    ==> (Ex #r. ResponderEstablished(I,R,link,key)@r & #r < #i)"

lemma responder_authenticates_initiator:
  "All I R link key #r. ResponderEstablished(I,R,link,key)@r
    ==> (Ex X #i. InitiatorBegin(I,R,link,X)@i & #i < #r)"

end
