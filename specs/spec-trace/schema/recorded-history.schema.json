{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twistedpear.dev/specs/spec-trace/schema/recorded-history.schema.json",
  "title": "SPEC-TRACE recorded history (on-disk form)",
  "description": "A trace wrapped with the kernel configuration snapshot needed to replay it. On disk, Uint8Array values are {\"$bytes\": \"<hex>\"} and Map values are {\"$map\": [[k, v], ...]}. Key order on disk is NOT significant: the trace hash is defined over the sorted-key canonical form, recomputed after parsing.",
  "type": "object",
  "required": ["version", "config", "trace"],
  "properties": {
    "version": { "const": 1 },
    "config": { "$ref": "#/$defs/config" },
    "trace": {
      "type": "array",
      "items": { "$ref": "trace-entry.schema.json" }
    },
    "violation": { "$ref": "#/$defs/violation" }
  },
  "additionalProperties": false,
  "$defs": {
    "config": {
      "type": "object",
      "required": ["seed", "startMs", "nodes"],
      "properties": {
        "seed": { "type": "integer" },
        "startMs": { "type": "number" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "delivery": { "$ref": "#/$defs/delivery" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "interleaveSalt": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "initial"],
      "properties": {
        "id": { "type": "string" },
        "machine": {
          "type": "string",
          "description": "Stable registry key resolving to a step function on replay."
        },
        "initial": {
          "description": "Machine-defined initial state; opaque to this spec."
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "latencyMs": { "type": "number", "minimum": 0 },
        "lossRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["source", "destination", "class"],
      "properties": {
        "source": { "type": "string" },
        "destination": { "type": "string" },
        "class": { "enum": ["lan", "internet", "ble", "lora"] },
        "params": { "type": "object" },
        "adversary": { "type": "string" },
        "powers": {
          "type": "array",
          "items": {
            "enum": ["drop", "delay", "reorder", "duplicate", "inject"]
          }
        }
      },
      "additionalProperties": false
    },
    "violation": {
      "type": "object",
      "required": ["oracle", "message"],
      "properties": {
        "oracle": { "type": "string" },
        "message": { "type": "string" },
        "nodes": { "type": "array", "items": { "type": "string" } },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
