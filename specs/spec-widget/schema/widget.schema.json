{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twistedpear.dev/specs/spec-widget/schema/widget.schema.json",
  "title": "SPEC-WIDGET widget tree and update stream",
  "description": "Generated from the host-side vocabulary tables in packages/miniapp-runtime/src/ui/schema.ts by scripts/generate-widget-schema.mjs — do not edit by hand. Budgets enforced by the host but not expressible here: 256 KiB serialized, 5000 nodes, depth 32; node ids must additionally be unique per tree.",
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "audio-meter",
            "button",
            "camera-preview",
            "code-editor",
            "divider",
            "image",
            "list",
            "map-preview",
            "progress",
            "qr-code",
            "remote-video",
            "scroll",
            "spacer",
            "switch",
            "text",
            "text-input",
            "view",
            "waveform"
          ]
        },
        "props": {
          "type": "object"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "audio-meter"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "session": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "button"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "event": true,
                    "label": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "camera-preview"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "aspectRatio": true,
                    "session": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "code-editor"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "event": true,
                    "language": {
                      "enum": [
                        "elm",
                        "javascript",
                        "json",
                        "text"
                      ]
                    },
                    "readOnly": true
                  },
                  "required": [
                    "documentId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "props"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "divider"
                },
                "props": {
                  "type": "object",
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "image"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "alt": true,
                    "asset": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "list"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "event": true,
                    "items": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "map-preview"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "session": true,
                    "zoom": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "progress"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "max": true,
                    "value": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "qr-code"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "caption": true,
                    "size": true,
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "props"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "remote-video"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "peer": true,
                    "session": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "scroll"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "event": true,
                    "scrollOffset": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "spacer"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "size": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "switch"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "event": true,
                    "value": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "text"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "value": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "text-input"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "event": true,
                    "placeholder": true,
                    "value": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "view"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "accessibilityLabel": true
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "waveform"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "session": true
                  },
                  "additionalProperties": false
                }
              }
            }
          ]
        }
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "alignItems": {
          "enum": [
            "stretch",
            "flex-start",
            "center",
            "flex-end"
          ]
        },
        "backgroundColor": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "display": {
          "enum": [
            "flex",
            "none"
          ]
        },
        "flexDirection": {
          "enum": [
            "row",
            "column"
          ]
        },
        "fontSize": {
          "enum": [
            12,
            14,
            16,
            20,
            24,
            32
          ]
        },
        "fontWeight": {
          "enum": [
            "regular",
            "medium",
            "bold"
          ]
        },
        "gap": {
          "type": "number"
        },
        "height": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?%$"
            }
          ]
        },
        "justifyContent": {
          "enum": [
            "flex-start",
            "center",
            "flex-end",
            "space-between"
          ]
        },
        "margin": {
          "type": "number"
        },
        "padding": {
          "type": "number"
        },
        "width": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?%$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tree": {
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "description": "Update-stream operation (ui/diff.ts). A replace whose id was absent from the previous frame signals a structural change; hosts always deliver the full next tree alongside the stream.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "id",
            "node"
          ],
          "properties": {
            "op": {
              "const": "replace"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "node": {
              "$ref": "#/$defs/node"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "id"
          ],
          "properties": {
            "op": {
              "const": "remove"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "patchStream": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    }
  }
}
