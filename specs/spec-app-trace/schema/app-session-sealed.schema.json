{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twistedpear.dev/specs/spec-app-trace/schema/app-session-sealed.schema.json",
  "title": "SPEC-APP-TRACE mini-app session (sealed)",
  "description": "X25519-ChaCha20-Poly1305 envelope around a shape or payload session. Identity is public; entries are ciphertext.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "mode",
    "identity",
    "recipientKey",
    "alg",
    "eph",
    "nonce",
    "ct"
  ],
  "properties": {
    "format": { "const": 1 },
    "kind": { "const": "miniapp-session" },
    "mode": { "const": "sealed" },
    "identity": { "$ref": "app-session.schema.json#/$defs/identity" },
    "recipientKey": { "$ref": "app-session.schema.json#/$defs/hex64" },
    "alg": { "const": "x25519-chacha20poly1305-v1" },
    "eph": { "$ref": "app-session.schema.json#/$defs/hex64" },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "ct": {
      "type": "string",
      "pattern": "^[0-9a-f]+$",
      "minLength": 32
    }
  }
}
