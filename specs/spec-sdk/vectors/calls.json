{
  "spec": "SPEC-SDK",
  "description": "Broker call vectors: (granted capabilities, call, args) -> (result | error code). Each vector runs its steps in order against a fresh host in the named configuration (default: standard) with the default app (all capabilities declared+granted) unless overridden. Results are normalized: bytes as {$bytes}, receivedAt/seq zeroed, lxmf message ids as lxmf-<id>. Covers every code in the error taxonomy plus recorded service-extension codes (e.g. INVALID_WIDGET). Replayed over both the loopback and reference bindings in CI.",
  "defaultApp": {
    "name": "vector-app",
    "declared": [
      "identity",
      "lxmf:send",
      "lxmf:receive",
      "storage:kv",
      "storage:hyperbee",
      "announce:publish",
      "announce:subscribe",
      "resource:fetch",
      "presence",
      "workspace",
      "share:cas",
      "ai:chat",
      "apps:package"
    ],
    "granted": [
      "identity",
      "lxmf:send",
      "lxmf:receive",
      "storage:kv",
      "storage:hyperbee",
      "announce:publish",
      "announce:subscribe",
      "resource:fetch",
      "presence",
      "workspace",
      "share:cas",
      "ai:chat",
      "apps:package"
    ],
    "register": true
  },
  "errorTaxonomy": [
    "UNKNOWN_CAPABILITY",
    "UNDECLARED_CAPABILITY",
    "CAPABILITY_DENIED",
    "CAPABILITY_MISMATCH",
    "UNKNOWN_METHOD",
    "RATE_LIMITED",
    "MESSAGE_TOO_LARGE",
    "BROKER_ERROR",
    "CONFIRMATION_UNAVAILABLE",
    "CONFIRMATION_TIMEOUT",
    "CONFIRMATION_DENIED",
    "APPS_UNCONFIGURED",
    "AI_UNCONFIGURED"
  ],
  "vectors": [
    {
      "name": "identity: destination hash and signing",
      "steps": [
        {
          "call": {
            "namespace": "identity",
            "method": "destinationHash",
            "capability": "identity"
          },
          "expect": {
            "ok": true,
            "result": "app:vector-app:publisher-vector"
          }
        },
        {
          "call": {
            "namespace": "identity",
            "method": "sign",
            "capability": "identity",
            "payload": {
              "payload": {
                "$textBytes": "payload"
              }
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "$bytes": "7369676e65643a7061796c6f6164"
            }
          }
        }
      ]
    },
    {
      "name": "ui: render a minimal tree",
      "steps": [
        {
          "call": {
            "namespace": "ui",
            "method": "render",
            "payload": {
              "tree": {
                "root": {
                  "id": "root",
                  "type": "text",
                  "props": {
                    "value": "hi"
                  }
                }
              }
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "accepted": true,
              "patchCount": 0
            }
          }
        }
      ]
    },
    {
      "name": "ui: invalid widget tree is rejected (service extension code)",
      "steps": [
        {
          "call": {
            "namespace": "ui",
            "method": "render",
            "payload": {
              "tree": {
                "root": {
                  "id": "root",
                  "type": "carousel"
                }
              }
            }
          },
          "expect": {
            "ok": false,
            "code": "INVALID_WIDGET"
          }
        }
      ]
    },
    {
      "name": "ui: event without an active app",
      "steps": [
        {
          "call": {
            "namespace": "ui",
            "method": "event",
            "payload": {
              "nodeId": "root",
              "event": "tap"
            }
          },
          "expect": {
            "ok": false,
            "code": "BROKER_ERROR",
            "messageIncludes": "No mini-app is running"
          }
        }
      ]
    },
    {
      "name": "storage.kv: set, get, isolation-scoped delete",
      "steps": [
        {
          "call": {
            "namespace": "storage.kv",
            "method": "set",
            "capability": "storage:kv",
            "payload": {
              "key": "greeting",
              "value": {
                "$textBytes": "hello"
              }
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "ok": true
            }
          }
        },
        {
          "call": {
            "namespace": "storage.kv",
            "method": "get",
            "capability": "storage:kv",
            "payload": {
              "key": "greeting"
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "$bytes": "68656c6c6f"
            }
          }
        },
        {
          "call": {
            "namespace": "storage.kv",
            "method": "delete",
            "capability": "storage:kv",
            "payload": {
              "key": "greeting"
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "ok": true
            }
          }
        },
        {
          "call": {
            "namespace": "storage.kv",
            "method": "get",
            "capability": "storage:kv",
            "payload": {
              "key": "greeting"
            }
          },
          "expect": {
            "ok": true,
            "result": null
          }
        }
      ]
    },
    {
      "name": "storage.kv: quota exhaustion",
      "steps": [
        {
          "call": {
            "namespace": "storage.kv",
            "method": "set",
            "capability": "storage:kv",
            "payload": {
              "key": "big",
              "value": {
                "$textBytes": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
              }
            }
          },
          "expect": {
            "ok": false,
            "code": "BROKER_ERROR",
            "messageIncludes": "quota"
          }
        }
      ]
    },
    {
      "name": "storage.bee: open, put, get, list",
      "steps": [
        {
          "call": {
            "namespace": "storage.bee",
            "method": "open",
            "capability": "storage:hyperbee"
          },
          "expect": {
            "ok": true,
            "result": {
              "appId": "vector-app",
              "localOnly": true,
              "namespace": "miniapp-bee:vector-app"
            }
          }
        },
        {
          "call": {
            "namespace": "storage.bee",
            "method": "put",
            "capability": "storage:hyperbee",
            "payload": {
              "key": "post:1",
              "value": {
                "$textBytes": "first"
              }
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "ok": true
            }
          }
        },
        {
          "call": {
            "namespace": "storage.bee",
            "method": "get",
            "capability": "storage:hyperbee",
            "payload": {
              "key": "post:1"
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "$bytes": "6669727374"
            }
          }
        },
        {
          "call": {
            "namespace": "storage.bee",
            "method": "list",
            "capability": "storage:hyperbee",
            "payload": {
              "options": {
                "limit": 10
              }
            }
          },
          "expect": {
            "ok": true,
            "result": [
              {
                "key": "post:1",
                "seq": 0,
                "value": {
                  "$bytes": "6669727374"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "storage.bee: quota exhaustion",
      "steps": [
        {
          "call": {
            "namespace": "storage.bee",
            "method": "put",
            "capability": "storage:hyperbee",
            "payload": {
              "key": "big",
              "value": {
                "$textBytes": "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
              }
            }
          },
          "expect": {
            "ok": false,
            "code": "BROKER_ERROR",
            "messageIncludes": "quota"
          }
        }
      ]
    },
    {
      "name": "lxmf: send to self and receive, inbox drains",
      "steps": [
        {
          "call": {
            "namespace": "lxmf",
            "method": "send",
            "capability": "lxmf:send",
            "payload": {
              "to": "vector-app",
              "subject": "hi",
              "body": "note to self"
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "id": "lxmf-<id>",
              "status": "queued"
            }
          }
        },
        {
          "call": {
            "namespace": "lxmf",
            "method": "receive",
            "capability": "lxmf:receive"
          },
          "expect": {
            "ok": true,
            "result": [
              {
                "body": "note to self",
                "from": "vector-app",
                "id": "lxmf-<id>",
                "receivedAt": 0,
                "subject": "hi"
              }
            ]
          }
        },
        {
          "call": {
            "namespace": "lxmf",
            "method": "receive",
            "capability": "lxmf:receive"
          },
          "expect": {
            "ok": true,
            "result": []
          }
        }
      ]
    },
    {
      "name": "announce: publish then subscribe",
      "steps": [
        {
          "call": {
            "namespace": "announce",
            "method": "publish",
            "capability": "announce:publish",
            "payload": {
              "appData": {
                "$textBytes": "post-1"
              }
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "published": true
            }
          }
        },
        {
          "call": {
            "namespace": "announce",
            "method": "subscribe",
            "capability": "announce:subscribe"
          },
          "expect": {
            "ok": true,
            "result": [
              {
                "appData": {
                  "$bytes": "706f73742d31"
                },
                "destination": "vector-app",
                "receivedAt": 0
              }
            ]
          }
        }
      ]
    },
    {
      "name": "presence: snapshot",
      "steps": [
        {
          "call": {
            "namespace": "presence",
            "method": "snapshot",
            "capability": "presence"
          },
          "expect": {
            "ok": true,
            "result": {
              "onlineInterfaces": 1,
              "peers": 2,
              "preferredInterface": "auto"
            }
          }
        }
      ]
    },
    {
      "name": "host: info",
      "steps": [
        {
          "call": {
            "namespace": "host",
            "method": "info",
            "capability": "presence"
          },
          "expect": {
            "ok": true,
            "resultKeys": [
              "grantedCapabilities",
              "hostApiVersion",
              "hostVersion",
              "interfaceTypes",
              "platform",
              "quotas",
              "roles"
            ]
          }
        }
      ]
    },
    {
      "name": "workspace: write, read, list",
      "steps": [
        {
          "call": {
            "namespace": "workspace",
            "method": "write",
            "capability": "workspace",
            "payload": {
              "path": "src/main.js",
              "content": "console.log(1)"
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "path": "src/main.js",
              "size": 14
            }
          }
        },
        {
          "call": {
            "namespace": "workspace",
            "method": "read",
            "capability": "workspace",
            "payload": {
              "path": "src/main.js"
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "content": "console.log(1)",
              "path": "src/main.js"
            }
          }
        },
        {
          "call": {
            "namespace": "workspace",
            "method": "list",
            "capability": "workspace",
            "payload": {
              "prefix": "src/"
            }
          },
          "expect": {
            "ok": true,
            "result": [
              {
                "path": "src/main.js",
                "size": 14
              }
            ]
          }
        }
      ]
    },
    {
      "name": "share.cas: put then get round-trips",
      "steps": [
        {
          "call": {
            "namespace": "share.cas",
            "method": "put",
            "capability": "share:cas",
            "payload": {
              "content": "shared blob"
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "t256": "3231c75f2b33d1a7cc41e8eb7618273f2311a3f43149a59979f869b87ed583ad"
            }
          }
        },
        {
          "call": {
            "namespace": "share.cas",
            "method": "get",
            "capability": "share:cas",
            "payload": {
              "t256": "3231c75f2b33d1a7cc41e8eb7618273f2311a3f43149a59979f869b87ed583ad"
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "content": "shared blob"
            }
          }
        }
      ]
    },
    {
      "name": "resource: fetch within budget",
      "steps": [
        {
          "call": {
            "namespace": "resource",
            "method": "fetch",
            "capability": "resource:fetch",
            "payload": {
              "resourceId": "offer:demo",
              "budgetBytes": 4096
            }
          },
          "expect": {
            "ok": true,
            "result": {
              "$bytes": "68656c6c6f2d7265736f75726365"
            }
          }
        }
      ]
    },
    {
      "name": "resource: budget exceeded",
      "steps": [
        {
          "call": {
            "namespace": "resource",
            "method": "fetch",
            "capability": "resource:fetch",
            "payload": {
              "resourceId": "offer:demo",
              "budgetBytes": 4
            }
          },
          "expect": {
            "ok": false,
            "code": "BROKER_ERROR",
            "messageIncludes": "budget"
          }
        }
      ]
    },
    {
      "name": "resource: unknown resource",
      "steps": [
        {
          "call": {
            "namespace": "resource",
            "method": "fetch",
            "capability": "resource:fetch",
            "payload": {
              "resourceId": "offer:missing"
            }
          },
          "expect": {
            "ok": false,
            "code": "BROKER_ERROR",
            "messageIncludes": "not found"
          }
        }
      ]
    },
    {
      "name": "capability: unknown capability in declared set",
      "app": {
        "name": "rogue-app",
        "declared": [
          "identity",
          "network:raw"
        ],
        "granted": [
          "identity",
          "network:raw"
        ],
        "register": false
      },
      "steps": [
        {
          "call": {
            "namespace": "identity",
            "method": "destinationHash",
            "capability": "identity"
          },
          "expect": {
            "ok": false,
            "code": "UNKNOWN_CAPABILITY"
          }
        }
      ]
    },
    {
      "name": "capability: granted but not declared",
      "app": {
        "name": "undeclared-app",
        "declared": [
          "identity"
        ],
        "granted": [
          "identity",
          "storage:kv"
        ],
        "register": false
      },
      "steps": [
        {
          "call": {
            "namespace": "storage.kv",
            "method": "get",
            "capability": "storage:kv",
            "payload": {
              "key": "x"
            }
          },
          "expect": {
            "ok": false,
            "code": "UNDECLARED_CAPABILITY"
          }
        }
      ]
    },
    {
      "name": "capability: declared but not granted",
      "app": {
        "name": "ungranted-app",
        "declared": [
          "identity",
          "storage:kv"
        ],
        "granted": [
          "identity"
        ],
        "register": true
      },
      "steps": [
        {
          "call": {
            "namespace": "storage.kv",
            "method": "get",
            "capability": "storage:kv",
            "payload": {
              "key": "x"
            }
          },
          "expect": {
            "ok": false,
            "code": "CAPABILITY_DENIED"
          }
        }
      ]
    },
    {
      "name": "capability: request names the wrong capability",
      "steps": [
        {
          "call": {
            "namespace": "storage.kv",
            "method": "get",
            "capability": "identity",
            "payload": {
              "key": "x"
            }
          },
          "expect": {
            "ok": false,
            "code": "CAPABILITY_MISMATCH"
          }
        }
      ]
    },
    {
      "name": "per-namespace denial: lxmf, announce, presence, workspace, share, resource",
      "app": {
        "name": "denied-app",
        "declared": [
          "identity",
          "lxmf:send",
          "lxmf:receive",
          "storage:kv",
          "storage:hyperbee",
          "announce:publish",
          "announce:subscribe",
          "resource:fetch",
          "presence",
          "workspace",
          "share:cas",
          "ai:chat",
          "apps:package"
        ],
        "granted": [
          "identity"
        ],
        "register": true
      },
      "steps": [
        {
          "call": {
            "namespace": "lxmf",
            "method": "send",
            "capability": "lxmf:send",
            "payload": {
              "to": "x",
              "subject": "s",
              "body": "b"
            }
          },
          "expect": {
            "ok": false,
            "code": "CAPABILITY_DENIED"
          }
        },
        {
          "call": {
            "namespace": "announce",
            "method": "publish",
            "capability": "announce:publish"
          },
          "expect": {
            "ok": false,
            "code": "CAPABILITY_DENIED"
          }
        },
        {
          "call": {
            "namespace": "presence",
            "method": "snapshot",
            "capability": "presence"
          },
          "expect": {
            "ok": false,
            "code": "CAPABILITY_DENIED"
          }
        },
        {
          "call": {
            "namespace": "workspace",
            "method": "list",
            "capability": "workspace"
          },
          "expect": {
            "ok": false,
            "code": "CAPABILITY_DENIED"
          }
        },
        {
          "call": {
            "namespace": "share.cas",
            "method": "put",
            "capability": "share:cas",
            "payload": {
              "content": "x"
            }
          },
          "expect": {
            "ok": false,
            "code": "CAPABILITY_DENIED"
          }
        },
        {
          "call": {
            "namespace": "resource",
            "method": "fetch",
            "capability": "resource:fetch",
            "payload": {
              "resourceId": "offer:demo"
            }
          },
          "expect": {
            "ok": false,
            "code": "CAPABILITY_DENIED"
          }
        }
      ]
    },
    {
      "name": "broker: unknown method",
      "steps": [
        {
          "call": {
            "namespace": "identity",
            "method": "teleport",
            "capability": "identity"
          },
          "expect": {
            "ok": false,
            "code": "UNKNOWN_METHOD"
          }
        }
      ]
    },
    {
      "name": "broker: rate limited",
      "setup": {
        "maxMessagesPerSecond": 4
      },
      "steps": [
        {
          "call": {
            "namespace": "identity",
            "method": "destinationHash",
            "capability": "identity"
          },
          "repeat": 6,
          "expect": {
            "ok": false,
            "code": "RATE_LIMITED"
          }
        }
      ]
    },
    {
      "name": "broker: message too large",
      "steps": [
        {
          "call": {
            "namespace": "storage.kv",
            "method": "set",
            "capability": "storage:kv",
            "payload": {
              "key": "big",
              "note": {
                "$asciiString": 300000
              }
            }
          },
          "expect": {
            "ok": false,
            "code": "MESSAGE_TOO_LARGE"
          }
        }
      ]
    },
