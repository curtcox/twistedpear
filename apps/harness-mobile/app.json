{
  "expo": {
    "name": "TwistedPear Harness",
    "slug": "harness-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "twistedpear-harness",
    "plugins": [
      "expo-dev-client",
      "expo-bare-kit",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TwistedPear to scan peer invitation QR codes."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow TwistedPear to attach camera tracks for peer media.",
          "microphonePermission": "Allow TwistedPear to attach microphone tracks for peer media."
        }
      ],
      "./modules/multicast/app.plugin.js",
      "./modules/bonjour/app.plugin.js",
      "./modules/ble-bridge/app.plugin.js",
      "./modules/usb-serial/app.plugin.js",
      "./modules/node-service/app.plugin.js",
      "./modules/peer-audio/app.plugin.js"
    ],
    "android": {
      "package": "network.twistedpear.harness"
    },
    "ios": {
      "bundleIdentifier": "network.twistedpear.harness",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
