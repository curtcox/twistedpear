{
  "name": "host-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b && node scripts/build-renderer-vendor.mjs && node scripts/build-worklet.mjs",
    "postinstall": "node scripts/ensure-electron.mjs --best-effort",
    "start": "npm run build && node scripts/ensure-electron.mjs && env -u ELECTRON_RUN_AS_NODE electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@twistedpear/host-core": "0.1.0",
    "@twistedpear/reticulum-interfaces": "0.2.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "bare": "^1.31.2",
    "bare-pack": "^2.2.1",
    "electron": "43.4.0",
    "electron-builder": "^26.15.7",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "network.twistedpear.host",
    "productName": "TwistedPear Host",
    "files": [
      "dist/**/*",
      "worklet/worklet.bundle",
      "src/renderer/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
