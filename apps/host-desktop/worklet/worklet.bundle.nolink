  "name": "hyperbee",
  "version": "2.27.3",
  "description": "An append-only B-tree running on a Hypercore.",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/**.js",
    "iterators/**.js"
  ],
  "dependencies": {
    "b4a": "^1.6.0",
    "codecs": "^3.0.0",
    "debounceify": "^1.0.0",
    "hypercore-errors": "^1.0.0",
