      bytesPerSync,
      maxOpenFiles,
      useDirectReads,
      avoidUnnecessaryBlockingIO,
      skipStatsUpdateOnOpen,
      useDirectIOForFlushAndCompaction,
      maxFileOpeningThreads,
      walRecoveryMode,
      bestEffortsRecovery,
      enableStatistics,
      statsLevel,
      walTtlSeconds,
      walSizeLimitMegabytes,
      avoidFlushDuringShutdown,
      walFilterPrefixes.map(encodePrefix)
