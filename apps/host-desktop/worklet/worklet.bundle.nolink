    }
    if (kinds.has(InterfaceKind.RNODE) && entry.packageSize > SIZE_WARNING_RNODE_BYTES) {
        return {
            allowed: true,
            warning: `Package size ${entry.packageSize} bytes is large for LoRa transfer`,
