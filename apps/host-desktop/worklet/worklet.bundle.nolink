    ["text", new Set(["value"])],
    ["image", new Set(["asset", "alt"])],
    ["button", new Set(["label", "event"])],
    ["text-input", new Set(["value", "placeholder", "event"])],
    ["switch", new Set(["value", "event"])],
    ["scroll", new Set(["event"])],
    ["list", new Set(["items", "event"])],
    ["progress", new Set(["value", "max"])],
    ["divider", new Set()],
