  preencode(state, m) {
    c.string.preencode(state, m.plugin)
    c.uint.preencode(state, m.version)
    c.uint.preencode(state, m.command)
    state.end++ // max flag is 1 so always one byte

    if (m.value) c.buffer.preencode(state, m.value)
