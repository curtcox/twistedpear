        return {
            phase: "offering",
            sessionId: event.sessionId,
            service: event.service,
            expiresAt: event.expiresAt,
            error: null,
        };
    }
    if (event.kind === "accept") {
        return event.replayed
            ? {
                phase: "rejected",
                sessionId: event.sessionId,
                service: event.service,
                expiresAt: event.expiresAt,
                error: "invitation replay",
            }
            : {
                phase: "answering",
                sessionId: event.sessionId,
                service: event.service,
                expiresAt: event.expiresAt,
                error: null,
            };
    }
    return {
        ...initialPeerPairingState(),
        phase: "rejected",
        error: "invalid pairing transition",
    };
}
