        throw new Error("Cannot unpad empty data");
    }
    const paddingLength = data[data.length - 1];
    if (paddingLength > blockSize || paddingLength === 0) {
        throw new Error(`Cannot unpad, invalid padding length of ${paddingLength} bytes`);
    }
