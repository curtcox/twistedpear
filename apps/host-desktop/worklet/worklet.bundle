    }

    const verifier =
      this.verifier ||
      new Verifier(this.header.key, Verifier.createManifest(manifest), { legacy: this._legacy })

    if (!verifier.verify(batch, batch.signature)) {
      throw INVALID_SIGNATURE('Proof contains an invalid signature', this.discoveryKey)
