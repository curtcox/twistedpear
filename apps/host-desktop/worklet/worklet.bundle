export class NamespacedLxmfService {
    kv;
    constructor(kv) {
        this.kv = kv;
    }
    async send(appId, request) {
        const id = `lxmf-${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;
        const outboxKey = this.outboxKey(appId);
        const outbox = await this.readMessages(outboxKey);
