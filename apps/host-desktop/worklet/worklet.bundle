        return {
            state,
            intents: [],
            actions: [
                {
                    kind: "deliver",
                    method: params?.method ?? LxmfDeliveryMethod.OPPORTUNISTIC,
                    representation: params?.representation ?? LxmfDeliveryRepresentation.UNKNOWN
                }
            ]
        };
    }
