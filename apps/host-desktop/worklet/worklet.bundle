export function initialLinkRelayTargetState() {
    return {};
}
export const stepLinkRelayTarget = (state, event) => {
    const result = stepLinkRelayTargetInner(state, event);
    return { state: result.state, intents: result.intents };
};
export function stepLinkRelayTargetWithActions(state, event) {
    return stepLinkRelayTargetInner(state, event);
}
export function linkRelayTargetFromActions(actions) {
    const action = actions[0];
    if (action === undefined || action.kind === "ignore") {
