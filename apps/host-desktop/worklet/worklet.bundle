        if (fields.transportId === null ||
            fields.transportId.length !== TRANSPORT_ID_BYTES) {
            throw new Error(`HEADER_2 packets require a ${TRANSPORT_ID_BYTES}-byte transport id`);
        }
    }
    const flags = packPacketFlags(fields);
    const header = fields.headerType === PACKET_HEADER_2
        ? concatBytes(new Uint8Array([flags, fields.hops & 0xff]), fields.transportId, fields.destinationHash)
        : concatBytes(new Uint8Array([flags, fields.hops & 0xff]), fields.destinationHash);
