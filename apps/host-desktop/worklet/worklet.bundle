            state: { state: LxmfMessageState.DELIVERED, progress: 1 },
            intents: []
        };
    }
    if (event.kind === "lxmf/mark-failed") {
        return {
            state: { state: LxmfMessageState.FAILED, progress: state.progress },
            intents: []
        };
