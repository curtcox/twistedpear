  encode(state, m) {
    const flags = m.value ? 1 : 0

    c.string.encode(state, m.plugin)
    c.uint.encode(state, m.version)
    c.uint.encode(state, m.command)
    c.uint.encode(state, flags)

    if (m.value) c.buffer.encode(state, m.value)
