}
/** Return the preferred online outgoing interface, if any. */
export function selectPreferredInterface(interfaces, options) {
    const ranked = rankOutgoingInterfaces(interfaces, options);
    return (ranked.find((entry) => entry.iface.online)?.iface ??
        ranked[0]?.iface ??
