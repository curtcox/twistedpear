            ]
        };
    }
    return { state, intents: [], actions: [] };
}
/** Extract the transport ingress dispatch plan from actions; null when empty. */
export function transportIngressDispatchPlanFromActions(actions) {
    const action = actions.find((entry) => entry.kind === "announce" ||
