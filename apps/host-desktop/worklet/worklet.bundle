        const wantsMoreHashmap = requestData[0] === RESOURCE_HASHMAP_IS_EXHAUSTED;
        const pad = wantsMoreHashmap ? 1 + RESOURCE_MAPHASH_LEN : 1;
        return requestData.subarray(pad, pad + RESOURCE_HASH_SIZE);
