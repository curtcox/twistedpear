        this.broker.register("announce", "subscribe", "announce:subscribe", async (request, context) => {
            const namespace = resolveAnnounceNamespace(context.appId, request.payload?.namespace);
            return this.announceService.subscribe(context.appId, namespace);
        });
        this.broker.register("resource", "fetch", "resource:fetch", (request, context) => {
            if (this.resourceService === null) {
                return Promise.reject(new Error("Resource fetch is not configured on this host"));
            }
            return Promise.resolve(this.resourceService.fetch(context.appId, request.payload));
        });
    }
    registerWorkspaceHandlers() {
        this.broker.register("workspace", "list", "workspace", (request, context) => {
            const prefix = request.payload?.prefix ?? "";
            return Promise.resolve(this.workspace.list(context.appId, prefix));
        });
        this.broker.register("workspace", "read", "workspace", async (request, context) => {
            const path = request.payload.path;
            return {
                path,
                content: await this.workspace.read(context.appId, path),
            };
        });
        this.broker.register("workspace", "write", "workspace", (request, context) => {
            const { path, content } = request.payload;
            if (typeof content !== "string") {
                return Promise.reject(new Error("Workspace content must be a string"));
            }
            return Promise.resolve(this.workspace.write(context.appId, path, content));
        });
        this.broker.register("workspace", "patch", "workspace", (request, context) => {
            const { path, baseLength, edits } = request.payload;
            return Promise.resolve(this.workspace.patch(context.appId, path, baseLength, edits));
        });
        this.broker.register("workspace", "delete", "workspace", async (request, context) => {
            const path = request.payload.path;
            await this.workspace.delete(context.appId, path);
            return { ok: true };
        });
    }
}
