import { MiniappHostLayer1HandlersServices } from "./layer-1-handlers-services.js";
export class MiniappHostLayer1HandlersFacilities extends MiniappHostLayer1HandlersServices {
    registerFacilitiesHandlers() {
        this.broker.register("notify", "post", "notify:post", (request, context) => {
            const notification = this.notifyService.post(context.appId, context.publisherPublicKey, request.payload);
            this.options.callbacks?.onNotification?.(notification);
            return notification;
        });
