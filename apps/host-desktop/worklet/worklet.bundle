    return firstActionOfKind(actions, "use-raw")?.raw ?? null;
}
export function initialUnpackPkcs7State() {
    return {};
}
export function stepPkcs7UnpadWithActions(state, event) {
    if (event.kind === "pkcs7/unpad-gate") {
        try {
            return {
                state,
                intents: [],
                actions: [
                    {
                        kind: "use-raw",
                        raw: pkcs7Unpad(event.data, event.blockSize ?? PKCS7_BLOCK_SIZE),
                    },
