    return {};
}
export function stepReverseEntryExpiredWithActions(state, event) {
    if (event.kind === "transport/reverse-entry-expired-gate") {
        const expiredInput = event.timeoutSeconds === undefined
            ? { timestamp: event.timestamp, nowSeconds: event.nowSeconds }
