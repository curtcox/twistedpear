export function shouldRejectPacketFromFieldsBadHeaderType(actions) {
    return hasActionOfKind(actions, "bad-header-type");
}
export function shouldRejectPacketFromFieldsBadContextFlag(actions) {
    return hasActionOfKind(actions, "bad-context-flag");
}
export function shouldRejectPacketFromFieldsBadTransportType(actions) {
