import { qualityForPeerRoute as routeQuality } from "./route-quality.js";
/** Concrete egress over an already authenticated host-owned peer route. */
export class PeerRouteStreamEgressFactory {
    routes;
    constructor(routes) {
        this.routes = routes;
    }
    create(input) {
        const route = this.routes.route(input.appId, { id: input.peer });
        if (route?.transport === undefined)
            return Promise.reject(new Error("The authenticated peer route has no media transport."));
        const plane = route.dataPlane === "webrtc"
            ? "webrtc"
            : route.dataPlane === "gateway"
                ? "pears-bulk"
                : "reticulum";
        if (plane !== input.admission.plane)
            return Promise.reject(new Error(`The admitted ${input.admission.plane} plane is not bound to this peer route.`));
