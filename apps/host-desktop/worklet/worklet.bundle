    return actions.some((action) => action.kind === "ignore");
}
export function shouldGiveUpChannelPacketTimeoutPlan(actions) {
    return actions.some((action) => action.kind === "give-up");
}
export function shouldRetryChannelPacketTimeoutPlan(actions) {
    return actions.some((action) => action.kind === "retry");
