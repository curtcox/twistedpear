            headerType: PacketHeaderType.HEADER_1,
            transportType: TransportType.BROADCAST,
            destinationType: DestinationType.LINK,
            packetType: PacketType.PROOF,
            destinationHash: this.linkId,
            context: PacketContext.LRPROOF,
            data: proofData
