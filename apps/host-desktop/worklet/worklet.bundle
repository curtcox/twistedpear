            this.pendingRequests.push(receipt);
        }
    }
    unregisterPendingRequest(receipt) {
        const stepped = stepPendingLinkRequestUnregisterWithActions(initialPendingLinkRequestUnregisterState(), {
            kind: "link/pending-request-unregister-gate",
            index: this.pendingRequests.indexOf(receipt)
