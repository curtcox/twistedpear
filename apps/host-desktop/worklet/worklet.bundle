            kind: "resource-adv/app-result-plan-gate",
            accepted: event.accepted
        }).actions;
        if (shouldRejectLinkResourceAcceptAppResultPlan(planActions)) {
            return {
                state: { ...state, waitingApp: false },
                intents: [],
                actions: [{ kind: "reject" }]
            };
        }
