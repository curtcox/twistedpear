        return { state, intents: [], actions: [] };
    }
    if (shouldMissChannelTxEnvelopeOp(stepChannelTxEnvelopeOpWithActions(initialChannelTxEnvelopeOpState(), {
        kind: "channel/tx-envelope-op-gate",
