    р: "p",
    с: "c",
    у: "y",
    х: "x",
    і: "i",
    ӏ: "l",
    А: "a",
    В: "b",
    Е: "e",
    К: "k",
    М: "m",
    Н: "h",
    О: "o",
    Р: "p",
    С: "c",
    Т: "t",
    Х: "x",
    Ι: "i",
    ο: "o",
    ν: "v",
    ι: "i",
