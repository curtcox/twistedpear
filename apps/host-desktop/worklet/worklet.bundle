    if (tag === 0xd9) {
        const length = bytes[offset + 1];
        const stringBytes = bytes.subarray(offset + 2, offset + 2 + length);
        return [utf8Decode(stringBytes), offset + 2 + length];
    }
    throw new Error(`Expected msgpack string tag, got 0x${tag.toString(16)}`);
