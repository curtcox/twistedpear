    setResourceStrategy(strategy) {
        this.resourceStrategy = strategy;
    }
    get trafficTimeoutFactor() {
        return LINK_TRAFFIC_TIMEOUT_FACTOR;
    }
    registerPendingRequest(receipt) {
        const register = stepPendingLinkRequestRegisterWithActions(initialPendingLinkRequestRegisterState(), {
            kind: "link/pending-request-register-gate",
            alreadyPresent: this.pendingRequests.includes(receipt)
