export function packResourceHashmapUpdate(segment, hashmap) {
    return msgpackPackArray([msgpackPackUInt(segment), msgpackPackBin(hashmap)]);
}
function readInt(value) {
    if (value === undefined || value.type !== "int") {
        return null;
    }
    return value.int;
}
function readBin(value) {
    if (value === undefined || value.type !== "bin") {
        return null;
    }
    return Uint8Array.from(value.bin);
}
export function unpackResourceHashmapUpdate(bytes) {
    try {
