        t: readInt(map.get("t")),
        d: readInt(map.get("d")),
        n: readInt(map.get("n")),
        h: readBin(map.get("h")),
        r: readBin(map.get("r")),
        o: readBin(map.get("o")),
        m: readBin(map.get("m")),
        f: readInt(map.get("f")),
        i: readInt(map.get("i")),
        l: readInt(map.get("l")),
