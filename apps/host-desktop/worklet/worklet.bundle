        if (shouldExtendPacketReceiptTimeoutNow(stepExtendPacketReceiptTimeoutWithActions(initialExtendPacketReceiptTimeoutState(), {
            kind: "channel/extend-packet-receipt-timeout-gate",
            currentTimeout: entry.currentTimeout,
            updatedTimeout
        }).actions)) {
            extensions.push({ index, timeoutSeconds: updatedTimeout });
        }
    }
