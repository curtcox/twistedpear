function assembleMediaFrame(store, appId, envelope) {
    if (envelope.payload.length < 8)
        return null;
    const view = new DataView(envelope.payload.buffer, envelope.payload.byteOffset, envelope.payload.byteLength);
    const frameId = view.getUint32(0, false);
    const index = view.getUint16(4, false);
    const count = view.getUint16(6, false);
    if (count < 1 || count > 32 || index >= count)
        return null;
