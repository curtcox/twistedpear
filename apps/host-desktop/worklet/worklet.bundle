        }
    }
    registerLxmfAnnounceHandlers() {
        this.broker.register("lxmf", "send", "lxmf:send", (request, context) => {
            const payload = request.payload;
            this.assertEgressAllowed(context.appId, "lxmf:send", "peer", payload.to, new TextEncoder().encode(JSON.stringify(payload)).length);
            return Promise.resolve(this.lxmfService.send(context.appId, payload));
        });
        this.broker.register("lxmf", "receive", "lxmf:receive", (_request, context) => Promise.resolve(this.lxmfService.receive(context.appId)));
        this.broker.register("announce", "publish", "announce:publish", async (request, context) => {
            const payload = request.payload;
            await this.announceService.publish(context.appId, boundAnnounceAppData(payload?.appData), resolveAnnounceNamespace(context.appId, payload?.namespace));
