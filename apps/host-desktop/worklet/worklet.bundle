    { kind: InterfaceKind.RNODE, aliases: ["rnode", "kiss", "lora"] },
    { kind: InterfaceKind.I2P, aliases: ["i2p", "sam"] },
    { kind: InterfaceKind.FREENET, aliases: ["freenet", "tplg"] },
