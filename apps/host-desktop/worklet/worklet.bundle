{
  "name": "hyperschema",
  "version": "1.21.0",
  "description": "Create registries of declarative compact-encoding schemas",
  "files": [
    "lib/*.js",
    "builder.mjs",
    "builder.cjs",
    "runtime.mjs",
    "runtime.cjs",
    "primitives.mjs",
    "primitives.cjs"
  ],
  "exports": {
    "./package": "./package.json",
    ".": {
      "import": "./builder.mjs",
      "default": "./builder.cjs"
    },
    "./runtime": {
      "import": "./runtime.mjs",
      "default": "./runtime.cjs"
    },
    "./primitives": {
      "import": "./primitives.mjs",
      "default": "./primitives.cjs"
    }
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "test": "prettier . --check && brittle test/index.js",
    "test:bare": "prettier . --check && bare test/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/hyperschema.git"
  },
  "author": "Holepunch",
