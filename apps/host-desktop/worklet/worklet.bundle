  }

  stop() {
    if (this._closing) return this
    binding.stop(this._handle)
    return this
  }

  ref() {
    if (this._closing) return this
    binding.ref(this._handle)
    return this
  }

  unref() {
    if (this._closing) return this
    binding.unref(this._handle)
    return this
  }

  close() {
