    if (event.kind === "pkcs7/pad-gate") {
        return {
            state,
            intents: [],
            actions: [
                {
                    kind: "use-raw",
                    raw: pkcs7Pad(event.data, event.blockSize ?? PKCS7_BLOCK_SIZE),
                },
            ],
        };
    }
