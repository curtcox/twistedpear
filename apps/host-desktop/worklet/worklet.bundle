    async listVersions() {
        const link = await this.openLink();
        const response = await sendPackageResourceRequest(link, { type: "list" });
        return parseListResponse(response);
    }
    async fetchVersion(version, options = {}) {
        const maxAttempts = options.maxAttempts ?? 3;
        let lastError = null;
        for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
            try {
                const link = await this.openLink();
                const archive = await sendPackageResourceRequest(link, { type: "fetch", version }, options.requestTimeoutMs === undefined
