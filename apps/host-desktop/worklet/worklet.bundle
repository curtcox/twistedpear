const treeHeader = {
  preencode (state, t) {
    c.uint.preencode(state, t.fork)
    c.uint.preencode(state, t.length)
    c.optionalBuffer.preencode(state, t.rootHash)
    c.optionalBuffer.preencode(state, t.signature)
