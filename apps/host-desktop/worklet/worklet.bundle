    async handleResourceAdvertisementPacket(packet) {
        const plaintext = this.decrypt(packet.data);
        if (!shouldDispatchLinkPlaintextNow(stepDispatchLinkPlaintextWithActions(initialDispatchLinkPlaintextState(), {
            kind: "link/dispatch-plaintext-gate",
            plaintextPresent: plaintext !== null
