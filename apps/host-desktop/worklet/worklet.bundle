  // 0, -1, 1, -2, 2, ...
  return n < 0n ? 2n * -n - 1n : n === 0n ? 0n : 2n * n
}

function validateSafeUint(n) {
  if (n > Number.MAX_SAFE_INTEGER)
    throw new Error(
      'uint is greater than the maximum safe integer, use biguint/bigint'
    )
  return n
}

