    REQUEST_SENT: 0x04,
    RECEIVING: 0x05,
    RESPONSE_RECEIVED: 0x06,
    COMPLETE: 0x07,
    NO_PATH: 0xf0,
    LINK_FAILED: 0xf1,
    TRANSFER_FAILED: 0xf2,
