    }
    recordConsent(record) {
        this.consentTranscript.append(record);
    }
    logActive(appId, line) {
        const entry = { appId, line, at: this.now() };
        const app = this.appById(appId);
        if (app !== undefined) {
            app.logs.push(entry);
            if (app.logs.length > 200) {
