  const head = r.getHead()
  const hints = r.getHints()
  const group = r.getGroup()

  r.tryFlush()

  const [authInfo, headInfo, hintsInfo, groupInfo] = await Promise.all([auth, head, hints, group])
  return {
    ...authInfo,
    head: headInfo,
    hints: hintsInfo,
    group: groupInfo
  }
