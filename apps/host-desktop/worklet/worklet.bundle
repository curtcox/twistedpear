        return onDeliveryReceiptStatus(state, event);
    if (event.kind === "timer/fired" &&
        event.id === DELIVERY_RECEIPT_POLL_TIMER_ID) {
        if (!state.armed || state.concluded) {
            return { state, intents: [], actions: [] };
