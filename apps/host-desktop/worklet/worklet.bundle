                    provider: options.provider,
                    runtime: options.runtime,
                });
    }
    start() {
        if (this.ownsReticulum)
            this.reticulum.start();
        return Promise.resolve();
    }
    stop() {
        if (this.ownsReticulum)
            this.reticulum.stop();
        return Promise.resolve();
    }
    get node() {
        return this.reticulum;
