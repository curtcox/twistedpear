      for (const name of Object.keys(headers)) {
        const n = name.toLowerCase()

        validate.validateHeaderName(n)
        validate.validateHeaderValue(n, headers[name])
      }
    }

    this._statusCode = statusCode
    this._statusMessage = statusMessage || null

