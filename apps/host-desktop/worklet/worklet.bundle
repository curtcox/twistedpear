export function firstAction(actions) {
    return actions[0];
}
/**
 * Narrow a step-action list to the first action of a given kind.
 * Callers read fields from the narrowed action instead of re-testing `kind`.
 */
export function firstActionOfKind(actions, kind) {
    return actions.find((entry) => entry.kind === kind);
}
export function hasActionOfKind(actions, kind) {
