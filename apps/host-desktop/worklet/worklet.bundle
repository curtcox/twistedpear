    if (state.end - state.start < 2) throw new Error('Out of bounds')
    return state.buffer[state.start++] * 0x100 + state.buffer[state.start++]
  }

  if (a === 0xfd) {
    return decodeUint32(state)
  }

  if (a === 0xfe) {
