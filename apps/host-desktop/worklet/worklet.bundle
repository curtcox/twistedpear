export function initialResourceHashmapSlotWritesPlanState() {
    return {};
}
export function stepResourceHashmapSlotWritesPlanWithActions(state, event) {
    if (event.kind === "resource/hashmap-slot-writes-plan-gate") {
        return {
            state,
