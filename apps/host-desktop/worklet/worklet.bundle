export function shouldRejectPacketFromFieldsBadDestinationType(actions) {
    return hasActionOfKind(actions, "bad-destination-type");
}
export function shouldRejectPacketFromFieldsBadPacketType(actions) {
    return hasActionOfKind(actions, "bad-packet-type");
}
export function shouldRejectPacketFromFieldsBadDestinationHash(actions) {
