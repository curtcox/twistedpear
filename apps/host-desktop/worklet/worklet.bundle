      // compat, drop at some point
      if (!manifest) manifest = Verifier.defaultSignerManifest(this.header.key)

      if (
        !manifest ||
        !(
          Verifier.isValidManifest(this.header.key, manifest) ||
          Verifier.isCompat(this.header.key, manifest)
