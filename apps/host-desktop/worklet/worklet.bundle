        return {
            state,
            intents: [],
            actions: [
                planPropagationStore({
                    quotas: event.quotas,
                    messageBytes: event.messageBytes,
                    alreadyStored: event.alreadyStored,
                    usedBytes: event.usedBytes,
                    entries: event.entries
