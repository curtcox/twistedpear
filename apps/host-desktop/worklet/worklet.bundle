        return {
            state: {
                armed: true,
                deadlineMs: event.at + event.timeoutMs,
                pathPresent: false,
                concluded: false,
                found: false
            },
            intents: [],
            actions: [{ kind: "probe" }]
        };
    }
    if (event.kind === "path-await/path-status") {
