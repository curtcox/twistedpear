    "resolve-reject-promise": "^1.1.0",
    "safety-catch": "^1.0.2",
    "streamx": "^2.12.4",
    "unslab": "^1.2.0"
  },
  "devDependencies": {
    "bare-process": "^4.2.2",
    "brittle": "^3.1.0",
    "hypercore": "^11.0.0",
    "lunte": "^1.0.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "protocol-buffers": "^4.2.0",
