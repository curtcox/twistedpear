                await this.applyLinkEstablishActions(stepLinkEstablishWithActions(initialLinkEstablishState({ initiator: this.initiator, status: this.status }), {
                    kind: "establish/activated",
                    atSeconds: nowSeconds,
                    rtt: mergedLinkRtt(measuredRtt, remoteRtt)
