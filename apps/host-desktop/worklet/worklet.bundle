    if (event.kind === "persist/request") {
        return {
            state: { pending: true },
            intents: [
                { kind: "timer/cancel", timer: { id: "persist-debounce" } },
                { kind: "timer/set", timer: { id: "persist-debounce", delayMs: PERSIST_DEBOUNCE_MS } }
