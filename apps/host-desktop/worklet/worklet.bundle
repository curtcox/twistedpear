export function initialPeerPairingState() {
    return {
        phase: "idle",
        sessionId: null,
        service: null,
        expiresAt: null,
        error: null,
    };
}
export function stepPeerPairing(state, event) {
    if (event.kind === "cancel")
        return cancelPairing(state);
    if (event.kind === "time")
        return expirePairing(state, event.now);
    if (state.phase === "idle")
        return startPairing(event);
