{
  "version": 1,
  "description": "Module and component coupling limits. Limits are hard: anything that crosses one fails the build unless it is pinned in an exemption map below, and a pin may shrink or disappear but never grow. A pin whose module is clean again also fails, so this file drains instead of accumulating. `maxDependsOn`, `maxInstability`, `maxFanOut`, `maxFanIn` and their barrel variants are hand-set policy that `--write` never touches: raising one is how a pull request states that a new dependency is intended, in the same diff that adds it.",
  "roots": [
    "packages",
    "apps",
    "scripts",
    "conformance"
  ],
  "maxFanOut": 15,
  "maxFanOutBarrel": 40,
  "barrels": [
    "(^|/)index\\.[^/]+$",
    "(^|/)lib\\.mjs$",
    "(^|/)shared\\.ts$",
    "(^|/)action-kind\\.ts$"
  ],
  "maxFanIn": 40,
  "maxFanInBarrel": 200,
  "maxDependsOn": {
    "*": 0,
    "apps/handbook": 3,
    "apps/harness-mobile": 15,
    "apps/host-desktop": 13,
    "conformance": 21,
    "packages/app-registry": 2,
    "packages/bridge-freenet": 2,
    "packages/bridge-hyper": 4,
    "packages/cas-256t": 1,
    "packages/cli": 9,
    "packages/effects": 0,
    "packages/host-core": 8,
    "packages/lxmf-ts": 3,
    "packages/miniapp-runtime": 3,
    "packages/miniapp-sdk": 1,
    "packages/miniapp-test": 1,
    "packages/peer-discovery": 1,
    "packages/protocol": 1,
    "packages/reticulum-interfaces": 1,
    "packages/reticulum-ts": 2,
    "packages/sim-adversaries": 3,
    "packages/sim-campaign": 4,
    "packages/widget-renderer-headless": 1,
    "packages/widget-renderer-rn": 1,
    "packages/worklet-core": 10,
    "scripts": 11
  },
  "maxInstability": {
    "*": 1,
    "packages/effects": 0.1,
    "packages/protocol": 0.25,
    "packages/cas-256t": 0.25,
    "packages/reticulum-ts": 0.3,
    "packages/reticulum-interfaces": 0.3,
    "packages/peer-discovery": 0.3,
    "packages/miniapp-runtime": 0.35,
    "packages/app-registry": 0.4
  },
  "sdpTolerance": 0.17,
  "fanOutExemptions": {
    "packages/miniapp-runtime/src/worklet.ts": 19,
    "packages/protocol/src/index/link.ts": 17,
    "packages/protocol/src/index/misc.ts": 26,
    "packages/reticulum-ts/src/link/layer-1.ts": 18,
    "packages/reticulum-ts/src/web.ts": 16,
    "packages/reticulum-ts/src/worklet.ts": 34,
    "apps/harness-mobile/worklet/web-entry.mjs": 16,
    "apps/host-desktop/worklet/entry.mjs": 18
  },
  "fanInExemptions": {
    "packages/reticulum-ts/src/crypto/bytes.ts": 42
  },
  "cycleExemptions": {
    "packages/effects/src/adapters/sim/kernel.ts": 2,
    "packages/host-core/src/interface-manager-open.ts": 2,
    "packages/miniapp-runtime/src/device-manager.ts": 9,
    "packages/reticulum-ts/src/channel.ts": 29
  },
  "sdpExemptions": {}
}
