#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")"

if [ -n "${LAUNCHER_PYTHON:-}" ]; then
  exec "$LAUNCHER_PYTHON" launcher.py launcher.txt
fi

major_minor="$(python3 -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")' 2>/dev/null || true)"
if [ -n "$major_minor" ] && command -v brew >/dev/null 2>&1; then
  brew_py="$(brew --prefix "python@${major_minor}" 2>/dev/null)/bin/python3"
  if [ -x "$brew_py" ]; then
    if "$brew_py" -c "import _tkinter" >/dev/null 2>&1; then
      exec "$brew_py" launcher.py launcher.txt
    fi
    echo "launcher: Homebrew Python is installed but Tcl/Tk support is missing." >&2
    echo "" >&2
    echo "Python: $brew_py ($major_minor)" >&2
    echo "" >&2
    echo "Install Tk support with:" >&2
    echo "  brew install python@${major_minor} python-tk@${major_minor}" >&2
    echo "" >&2
    echo "Then run:" >&2
    echo "  ./launch" >&2
    exit 1
  fi
fi

for py in /usr/bin/python3 python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import _tkinter" >/dev/null 2>&1; then
    exec "$py" launcher.py launcher.txt
  fi
done

exec python3 launcher.py launcher.txt
