        headerType: (flags & 0b11000000) >> 6,
        contextFlag: (flags & 0b00100000) >> 5,
        transportType: (flags & 0b00010000) >> 4,
        destinationType: (flags & 0b00001100) >> 2,
        packetType: flags & 0b00000011
