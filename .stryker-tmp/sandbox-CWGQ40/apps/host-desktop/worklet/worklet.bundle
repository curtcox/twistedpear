        watchdog = stepLinkWatchdogWithActions(watchdog, {
            kind: "link/rtt-measured",
            rtt: event.rtt
        }).state;
        watchdog = stepLinkWatchdogWithActions(watchdog, {
            kind: "link/inbound",
            at: event.at
        }).state;
