            state: {
                ...state,
                status: LinkStatus.HANDSHAKE,
                established: false,
                watchdog: watchdog.state
            },
            intents: [],
            actions: [{ kind: "send-handshake", peerId: state.peerId }]
        };
    }
    if (event.kind === "session/link-proof") {
