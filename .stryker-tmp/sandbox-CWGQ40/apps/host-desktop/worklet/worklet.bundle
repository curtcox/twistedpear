    this._remoteAddress = address
    this._remoteFamily = UDX.isIP(address)

    if (cb) this.once('connect', cb)

    queueMicrotask(() => this.emit('connect'))
  }

  async close (cb) {
    try {
      await this._socket.close()

      if (cb) cb(null)
    } catch (err) {
