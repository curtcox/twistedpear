export function packWebIdentityRecord(salt, iv, ciphertext) {
    if (salt.length !== WEB_IDENTITY_SALT_BYTES) {
        throw new Error(`web identity salt must be ${WEB_IDENTITY_SALT_BYTES} bytes`);
    }
    if (iv.length !== WEB_IDENTITY_IV_BYTES) {
