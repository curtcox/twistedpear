        case "speaker":
            return { kind: "speaker", accepted: true, normalized: validateSpeaker(command) };
        case "tts":
            return { kind: "tts", accepted: true, normalized: validateTts(command) };
        case "haptics":
            return { kind: "haptics", accepted: true, normalized: validateHaptics(command) };
        case "nfc":
            return { kind: "nfc", accepted: true, normalized: validateNfc(command) };
