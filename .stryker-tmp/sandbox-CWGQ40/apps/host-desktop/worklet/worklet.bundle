    if (event.kind === "resource/complete") {
        return { state: { status: ResourceStatus.COMPLETE }, intents: [] };
    }
    if (event.kind === "resource/corrupt") {
        return { state: { status: ResourceStatus.CORRUPT }, intents: [] };
    }
