                status: LinkStatus.CLOSED,
                established: false,
                watchdog: { ...state.watchdog, status: LinkStatus.CLOSED }
            },
            intents: [],
            actions: [{ kind: "close", reason: LinkTeardownReason.INITIATOR_CLOSED }]
        };
    }
