    if (event.kind === "resource/transferring") {
        return { state: { status: ResourceStatus.TRANSFERRING }, intents: [] };
    }
    if (event.kind === "resource/awaiting-proof") {
        return { state: { status: ResourceStatus.AWAITING_PROOF }, intents: [] };
