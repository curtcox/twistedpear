        goodputBps: finiteNonNegative(reported.goodputBps),
        rttMs: finiteNonNegative(reported.rttMs),
        jitterMs: finiteNonNegative(reported.jitterMs ?? 0),
        lossRatio: clamp(finiteNonNegative(reported.lossRatio ?? 0), 0, 1),
