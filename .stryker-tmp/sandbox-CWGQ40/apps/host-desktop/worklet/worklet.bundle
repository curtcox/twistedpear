            kind: "reject",
            plane: "cas",
            rung: ladder[ladder.length - 1] ?? "on-demand",
            rungIndex: Math.max(0, ladder.length - 1),
            demandBps: demandBps(demand),
            admittedDemandBps: 0,
            supplyBps: 0,
            reason: "DEVICE_BANDWIDTH_INSUFFICIENT: no candidate plane"
