function stepLinkResourceAdvertisementInner(state, event) {
    if (event.kind === "resource-adv/received") {
        const planActions = stepLinkResourceAdvertisementPlanWithActions(initialLinkResourceAdvertisementPlanState(), {
            kind: "resource-adv/advertisement-plan-gate",
            isRequest: event.isRequest,
            strategy: state.strategy
        }).actions;
