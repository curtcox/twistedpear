    const current = next.get(event.id);
    if (current === undefined || current.phase !== "active")
        return next;
    if (event.kind === "share/revoke") {
        next.set(event.id, { ...current, phase: "revoked", revokedAt: event.at });
    }
    else if (event.at >= current.expiresAt) {
