        {
            from: "active",
            on: degrade,
            to: "degraded",
            reduce: (state, event) => event.kind === "device/degrade" ? { ...state, degradationRung: event.rung } : state
        },
        {
            from: "degraded",
            on: restore,
            to: "active",
            reduce: (state, event) => event.kind === "device/restore" ? { ...state, degradationRung: event.rung } : state
        },
        {
            from: "degraded",
            on: degrade,
            to: "degraded",
            reduce: (state, event) => event.kind === "device/degrade" ? { ...state, degradationRung: event.rung } : state
        },
        {
            from: "active",
            on: close,
            to: "closed",
            reduce: (state, event) => event.kind === "device/close" ? { ...state, closedAt: event.at } : state
        },
        {
            from: "degraded",
            on: close,
            to: "closed",
            reduce: (state, event) => event.kind === "device/close" ? { ...state, closedAt: event.at } : state
        },
        {
            from: "active",
            on: ttlExpired,
            to: "expired",
            guard: (state, event) => event.kind === "device/ttl" && state.expiresAt !== null && event.at >= state.expiresAt
        },
        {
            from: "degraded",
            on: ttlExpired,
            to: "expired",
            guard: (state, event) => event.kind === "device/ttl" && state.expiresAt !== null && event.at >= state.expiresAt
        },
        {
            from: "active",
            on: revoke,
            to: "revoked",
            reduce: (state, event) => event.kind === "device/revoke" ? { ...state, revokedAt: event.at } : state
        },
        {
            from: "degraded",
            on: revoke,
            to: "revoked",
            reduce: (state, event) => event.kind === "device/revoke" ? { ...state, revokedAt: event.at } : state
        }
    ]
