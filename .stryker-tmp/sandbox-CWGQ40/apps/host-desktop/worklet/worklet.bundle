export const InterfaceKind = {
    AUTO: "auto",
    TCP: "tcp",
    UDP: "udp",
    BLE: "ble",
    BLUETOOTH: "bluetooth",
    RNODE: "rnode",
    I2P: "i2p",
    FREENET: "freenet",
    OPTICAL: "optical",
    ACOUSTIC: "acoustic",
    NTFY: "ntfy",
    UNKNOWN: "unknown"
