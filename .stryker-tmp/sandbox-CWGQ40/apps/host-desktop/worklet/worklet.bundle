                state,
                intents: [],
                actions: [
                    {
                        kind: "use-raw",
                        raw: packChannelEnvelope({
                            msgType: event.msgType,
                            sequence: event.sequence,
                            payload: event.payload
                        })
                    }
                ]
            };
        }
        catch {
            return { state, intents: [], actions: [{ kind: "reject" }] };
        }
    }
    return { state, intents: [], actions: [] };
}
