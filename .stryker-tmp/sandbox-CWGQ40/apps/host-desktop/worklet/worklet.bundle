        rttMs: ewma(prior?.rttMs, finiteNonNegative(measurement.rttMs), alpha),
        jitterMs: ewma(prior?.jitterMs, finiteNonNegative(measurement.jitterMs ?? 0), alpha),
        lossRatio: clamp(ewma(prior?.lossRatio, sampleLoss, alpha), 0, 1),
