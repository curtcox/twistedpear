    if (timestampValue === undefined ||
        titleValue === undefined ||
        contentValue === undefined ||
        fieldsValue === undefined ||
        timestampValue.type !== "float" ||
        titleValue.type !== "bin" ||
        contentValue.type !== "bin" ||
        fieldsValue.type !== "map") {
        throw new Error("Invalid LXMF payload fields");
    }
