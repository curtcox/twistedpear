        return this.manager.inventory();
    }
    diagnostics(_appId) {
        return this.manager.diagnostics();
    }
    open(appId, publisherPublicKey, declared, granted, payload) {
        return this.manager.open(appId, publisherPublicKey, declared, granted, payload);
