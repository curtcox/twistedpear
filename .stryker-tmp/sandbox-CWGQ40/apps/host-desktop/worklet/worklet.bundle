    let normB = 0;
    for (let index = 0; index < a.length; index += 1) {
        const left = a[index];
        const right = b[index];
        if (!Number.isFinite(left) || !Number.isFinite(right)) {
            throw new AiServiceError("AI_BACKEND_ERROR", "Embedding vectors must contain finite numbers.");
        }
        dot += left * right;
        normA += left * left;
        normB += right * right;
    }
    if (normA === 0 || normB === 0)
