    }
    const rung = ladder[rungIndex] ?? ladder[ladder.length - 1] ?? "on-demand";
    const admittedDemand = demandAtRung(requiredBps, profileMinimumBps(demand), rungIndex - requestedRungIndex, ladder.length - requestedRungIndex);
