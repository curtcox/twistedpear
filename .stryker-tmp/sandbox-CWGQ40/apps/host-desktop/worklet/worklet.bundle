  static SERVER_IS_CLOSED(msg) {
    return new PipeError(msg, PipeError.SERVER_IS_CLOSED)
  }

  static INVALID_IPC_TARGET(msg) {
    return new PipeError(msg, PipeError.INVALID_IPC_TARGET)
