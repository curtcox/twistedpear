    InterfaceKind.AUTO,
    InterfaceKind.TCP,
    InterfaceKind.UDP,
    InterfaceKind.BLE,
    InterfaceKind.BLUETOOTH,
    InterfaceKind.RNODE,
    InterfaceKind.I2P,
    InterfaceKind.FREENET,
    InterfaceKind.OPTICAL,
    InterfaceKind.ACOUSTIC,
    InterfaceKind.NTFY,
    InterfaceKind.UNKNOWN
