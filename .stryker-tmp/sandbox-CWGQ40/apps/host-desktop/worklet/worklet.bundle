        { from: "deferred", on: admit, to: "active" },
        { from: "deferred", on: degrade, to: "degraded", reduce: withRung },
        { from: "deferred", on: reject, to: "rejected" },
        { from: "active", on: degrade, to: "degraded", reduce: withRung },
        { from: "active", on: close, to: "closed" },
