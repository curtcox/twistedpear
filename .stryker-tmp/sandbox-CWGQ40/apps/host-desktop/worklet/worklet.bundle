  BlockMapReadStream,
  BlobReadStream,
  BlobWriteStream
}

function noop() {}

function seekBlockMap(map, start, end) {
  let s = -1
  let so = -1
  let e = -1
  let eo = -1

  for (let i = 0; i < map.blocks.length; i++) {
    const b = map.blocks[i]

    if (s === -1) {
      if (start < b.byteLength) {
        s = i
        so = start
      } else {
        start -= b.byteLength
      }
    }

    if (e === -1 && end > -1) {
      if (end <= b.byteLength) {
        e = i + 1
        eo = b.byteLength - end
      } else {
        end -= b.byteLength
      }
    }
  }

  return [s, so, e, eo]
}
