            appId: context.appId,
            publisherPublicKey: context.publisherPublicKey,
            summary: {
                operation: "update",
                keyHex,
                stateBytes: String(stateHex.length / 2),
                note: "Updates are published to a global network and cannot be recalled."
            }
        }, confirmationEffects);
