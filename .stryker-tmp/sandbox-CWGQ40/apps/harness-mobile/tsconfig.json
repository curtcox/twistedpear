{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./types/**/*.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
