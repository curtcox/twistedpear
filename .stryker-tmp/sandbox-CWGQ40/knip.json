{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "formal/**/*.mjs",
        "conformance/**/*.mjs",
        "conformance/**/*.test.mjs",
        "vitest.config.ts",
        "vitest.workspace.ts"
      ],
      "project": ["scripts/**/*.{js,mjs,ts}", "formal/**/*.{js,mjs,ts}", "conformance/**/*.{js,mjs,ts}"]
    },
    "packages/*": {
      "entry": ["src/index.{ts,tsx,js,mjs}", "test/**/*.test.{ts,tsx,js,mjs}"],
      "project": ["src/**/*.{ts,tsx,js,mjs}", "test/**/*.{ts,tsx,js,mjs}"],
      "ignore": ["src/**/*.gen.ts"]
    },
    "apps/*": {
      "entry": ["src/**/*.{ts,tsx,js,mjs}", "test/**/*.test.{ts,tsx,js,mjs}", "scripts/**/*.{js,mjs}"],
      "project": ["**/*.{ts,tsx,js,mjs}"],
      "ignore": ["**/*.bundle.mjs", "**/*.bundle"]
    }
  },
  "ignore": ["archive/**", "site/**", "**/dist/**", "**/*.gen.ts", "**/*.bundle.mjs", "**/*.bundle"]
}
