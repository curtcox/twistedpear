{
  "component": "View",
  "id": "root",
  "style": {
    "padding": 16,
    "gap": 12
  },
  "children": [
    {
      "component": "Text",
      "id": "title",
      "props": {
        "value": "Chat"
      },
      "style": {
        "fontSize": 20,
        "fontWeight": "700"
      }
    },
    {
      "component": "TextInput",
      "id": "peer-input",
      "props": {
        "value": "",
        "placeholder": "Peer app id",
        "event": "chat.peer"
      }
    },
    {
      "component": "Button",
      "id": "send",
      "props": {
        "label": "Send hello",
        "event": "chat.send"
      }
    },
    {
      "component": "ScrollView",
      "id": "inbox-scroll",
      "children": [
        {
          "component": "Text",
          "id": "inbox",
          "props": {
            "value": "No messages yet"
          }
        }
      ]
    }
  ]
}
