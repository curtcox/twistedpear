{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twistedpear.dev/specs/spec-trace/schema/trace-entry.schema.json",
  "title": "SPEC-TRACE trace entry (serialized form)",
  "description": "One entry of a replayable trace, in the serialized JSON form where Uint8Array values are encoded as {\"$bytes\": \"<lowercase hex>\"}. Event and intent payloads use the closed alphabet normatively owned by SPEC-EVENTS, referenced from specs/spec-events/schema/events.schema.json.",
  "oneOf": [
    { "$ref": "#/$defs/eventEntry" },
    { "$ref": "#/$defs/intentEntry" },
    { "$ref": "#/$defs/advanceEntry" }
  ],
  "$defs": {
    "eventEntry": {
      "type": "object",
      "required": ["t", "node", "event"],
      "properties": {
        "t": { "const": "event" },
        "node": { "type": "string" },
        "event": { "$ref": "../../spec-events/schema/events.schema.json#/$defs/event" }
      },
      "additionalProperties": false
    },
    "intentEntry": {
      "type": "object",
      "required": ["t", "node", "intent"],
      "properties": {
        "t": { "const": "intent" },
        "node": { "type": "string" },
        "intent": { "$ref": "../../spec-events/schema/events.schema.json#/$defs/intent" }
      },
      "additionalProperties": false
    },
    "advanceEntry": {
      "type": "object",
      "required": ["t", "at"],
      "properties": {
        "t": { "const": "advance" },
        "at": { "type": "number" }
      },
      "additionalProperties": false
    },
    "bytes": {
      "description": "Serialized Uint8Array: lowercase hex, two digits per byte.",
      "type": "object",
      "required": ["$bytes"],
      "properties": {
        "$bytes": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" }
      },
      "additionalProperties": false
    }
  }
}
