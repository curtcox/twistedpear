{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "formal/**/*.mjs",
        "conformance/**/*.mjs",
        "conformance/**/*.test.mjs",
        "vitest.config.ts",
        "scripts/site/react-native-web-samples/entry.tsx",
        "eslint.config.js",
        "eslint.*.config.js",
        "eslint.concat-groups.mjs",
        "stryker.config.mjs"
      ],
      "project": [
        "scripts/**/*.{js,mjs,ts,tsx}",
        "formal/**/*.{js,mjs,ts}",
        "conformance/**/*.{js,mjs,ts}",
        "eslint*.{js,mjs}",
        "stryker.config.mjs"
      ]
    },
    "packages/*": {
      "entry": ["src/index.{ts,tsx,js,mjs}", "test/**/*.test.{ts,tsx,js,mjs}"],
      "project": ["src/**/*.{ts,tsx,js,mjs}", "test/**/*.{ts,tsx,js,mjs}"],
      "ignore": ["src/**/*.gen.ts"]
    },
    "apps/*": {
      "entry": [
        "src/**/*.{ts,tsx,js,mjs}",
        "test/**/*.test.{ts,tsx,js,mjs}",
        "scripts/**/*.{js,mjs}",
        "index.js",
        "App.web.tsx",
        "worklet/prelude.mjs",
        "worklet/entry.mjs",
        "worklet/web-entry.mjs",
        "modules/*/app.plugin.js",
        "stubs/*.web.js"
      ],
      "project": ["**/*.{ts,tsx,js,mjs}"],
      "ignore": ["**/*.bundle.mjs", "**/*.bundle"]
    }
  },
  "ignoreDependencies": [
    "@ast-grep/cli",
    "@expo/config-plugins",
    "@microsoft/api-extractor",
    "bare-os",
    "bare-process",
    "bare-runtime",
    "jscpd",
    "mermaid",
    "qrcode-generator",
    "react",
    "react-dom",
    "react-native",
    "type-coverage",
    "vitepress-plugin-mermaid"
  ],
  "exclude": ["duplicates"],
  "ignoreUnresolved": ["./gradlew", "./protocol.ts"],
  "ignoreBinaries": [
    "adb",
    "caffeinate",
    "gitleaks",
    "gradlew",
    "lizard",
    "maestro",
    "osascript",
    "rg",
    "rustc",
    "tail",
    "xdg-open"
  ],
  "ignore": [
    "archive/**",
    "site/**",
    "**/dist/**",
    "**/*.gen.ts",
    "**/*.bundle.mjs",
    "**/*.bundle",
    "**/*.bundle.js",
    "apps/harness-mobile/android/**",
    "apps/harness-mobile/ios/**",
    "apps/harness-mobile/public/**",
    "apps/harness-mobile/worklet/entry-part-*.mjs",
    "apps/harness-mobile/worklet/web-entry-part-*.mjs",
    "packages/reticulum-ts/docs/api/**",
    "conformance/docs/.tmp-handbook-capture/**",
    "conformance/fixtures/packages/**",
    "conformance/**/fixtures.mjs",
    "conformance/**/publisher-data.mjs",
    "conformance/**/web-core.worker.js",
    "conformance/**/web-hyper-fetch.js",
    "conformance/web-storage/fixture.mjs",
    "apps/handbook/generated/**",
    "apps/handbook/seeds/**"
  ]
}
